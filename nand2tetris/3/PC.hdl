/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    // determine if counter should be updated
    Or(a=reset, b=load, out=loadTemp);
    Or(a=loadTemp, b=inc, out=shouldLoad);

    // determine value of counter
    Inc16(in=regValue, out=incremented);
    Mux16(a=in, b=incremented, sel=inc, out=inputTemp0);
    Mux16(a=incremented, b=in, sel=load, out=inputTemp1);
    Mux16(a=inputTemp1, b=false, sel=reset, out=processedInput);

    Register(in=processedInput, load=shouldLoad, out=out, 
        out=regValue);
}
